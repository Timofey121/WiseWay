FROM ghcr.io/astral-sh/uv:0.11.2@sha256:c4f5de312ee66d46810635ffc5df34a1973ba753e7241ce3a08ef979ddd7bea5 AS uv
FROM python:3.11.15-alpine3.24@sha256:25976e9d34a0fab1f278cae931f34c8303d97bf0c0d7f85b6b4dcf641d7702a4
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never \
    PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /opt/wiseway
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project
COPY backend backend
COPY contracts contracts
RUN uv sync --frozen --no-editable \
    && addgroup -S -g 10001 wiseway && adduser -S -D -H -u 10001 -G wiseway wiseway \
    && mkdir /benchmark && chown 10001:10001 /benchmark
USER 10001:10001
STOPSIGNAL SIGTERM
ENTRYPOINT ["python", "backend/benchmarks/archive_capacity.py"]


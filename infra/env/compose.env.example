# Copy to .env; use absolute private paths owned by UID/GID 10001.
# For deployment replace the local image with the exact published image@sha256:digest.
WISEWAY_IMAGE=wiseway:local
WISEWAY_ORIGINS=https://wiseway.example
WISEWAY_STATE_PATH=/var/lib/wiseway/state
WISEWAY_SANDBOX_PATH=/srv/wiseway/sandbox
WISEWAY_BACKUP_PATH=/var/backups/wiseway
WISEWAY_TLS_PATH=/etc/wiseway/tls
WISEWAY_BIND_ADDRESS=0.0.0.0
WISEWAY_HTTPS_PORT=443
WISEWAY_WORKER_STALE_SECONDS=900

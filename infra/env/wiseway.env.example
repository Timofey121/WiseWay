# Copy to /etc/wiseway/wiseway.env and restrict it to the wiseway service account.
# This profile remains valid only for the marked synthetic sandbox until a separate
# real-storage adapter and approved root configuration exist.
WISEWAY_DATA_DIR=/var/lib/wiseway/state
WISEWAY_SANDBOX_DIR=/srv/wiseway/sandbox
WISEWAY_ORIGINS=https://wiseway.example
WISEWAY_SECURE_COOKIE=true
WISEWAY_TRUST_PROXY_HEADERS=true
WISEWAY_WORKER_STALE_SECONDS=900

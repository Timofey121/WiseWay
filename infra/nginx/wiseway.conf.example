# TLS terminates here. Keep the application bound to 127.0.0.1:8000.
server {
    listen 443 ssl;
    server_name wiseway.example;

    ssl_certificate /etc/ssl/certs/wiseway.example.fullchain.pem;
    ssl_certificate_key /etc/ssl/private/wiseway.example.key;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
    }
}

[Unit]
Description=Wise Way SQLite database backup
After=wiseway-api.service

[Service]
Type=oneshot
User=wiseway
Group=wiseway
UMask=0077
WorkingDirectory=/opt/wiseway
EnvironmentFile=/etc/wiseway/wiseway.env
ExecStart=/bin/sh -c 'exec /opt/wiseway/.venv/bin/wiseway backup /var/backups/wiseway/wiseway-$$(date -u +%%Y%%m%%dT%%H%%M%%SZ).sqlite3'
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wiseway /var/backups/wiseway
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
